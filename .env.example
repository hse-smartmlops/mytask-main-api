# === Application ===
# Название приложения (используется в логах и метриках)
APP_NAME=emplacc-api
# Версия приложения
APP_VERSION=1.0.0
# Текущее окружение: development/staging/production
APP_ENV=development
# Часовой пояс по умолчанию
APP_TIMEZONE=Europe/Moscow

# === Server ===
# IP/хост для прослушивания HTTP-сервера
SERVER_HOST=0.0.0.0
# Порт HTTP-сервера
SERVER_PORT=8081
# Таймаут чтения запроса
SERVER_READ_TIMEOUT=15s
# Таймаут записи ответа
SERVER_WRITE_TIMEOUT=30s
# Время на корректное завершение работы
SERVER_SHUTDOWN_TIMEOUT=10s
# Разрешённые CORS происхождения
SERVER_ALLOWED_ORIGINS=*
# Разрешённые CORS методы
SERVER_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
# Разрешённые CORS заголовки
SERVER_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
# Разрешать передачу авторизационных данных в CORS
SERVER_ALLOW_CREDENTIALS=true

# === Database ===
# Имя БД PostgreSQL
DB_NAME=emplacc
# Пользователь PostgreSQL
DB_USER=postgres
# Пароль PostgreSQL
DB_PASS=
# Порт PostgreSQL
DB_PORT=5432
# Хост PostgreSQL
DB_HOST=localhost
# Режим SSL-соединения
DB_SSLMODE=disable
# Часовой пояс соединения
DB_TIMEZONE=Europe/Moscow
# Максимум открытых соединений
DB_MAX_OPEN_CONNS=50
# Максимум простаивающих соединений
DB_MAX_IDLE_CONNS=10
# Максимальное время жизни соединения
DB_CONN_MAX_LIFETIME=1h
# Запуск автоматической миграции схемы
DB_AUTO_MIGRATE=true

# === Logger ===
# Уровень логирования
LOG_LEVEL=info
# Формат логов: text/json
LOG_FORMAT=text
# Файл для записи логов (пусто = stdout)
LOG_FILE=
# Максимальный размер лог-файла до ротации
LOG_MAX_SIZE_MB=50
# Количество резервных лог-файлов
LOG_MAX_BACKUPS=5
# Максимальный возраст лог-файлов
LOG_MAX_AGE_DAYS=30
# Сжимать ли архивные логи
LOG_COMPRESS=true

# === Swagger ===
# Включить/выключить Swagger UI
SWAGGER_ENABLED=true
# Заголовок документации
SWAGGER_TITLE=Emplacc API
# Описание API
SWAGGER_DESCRIPTION=API для Emplacc.
# Версия API
SWAGGER_VERSION=1.0
# Публичный хост для ссылок (опционально)
SWAGGER_HOST=
# Базовый путь API
SWAGGER_BASE_PATH=/
# Список схем (http,https) через запятую
SWAGGER_SCHEMES=

# === Keycloak ===
# Базовый URL Keycloak
KEYCLOAK_URL=
# Realm Keycloak
KEYCLOAK_REALM=
# ID клиента
KEYCLOAK_CLIENT_ID=
# Секрет клиента
KEYCLOAK_CLIENT_SECRET=
# ID backend-клиента для exchange (опционально)
KEYCLOAK_BACKEND_CLIENT_ID=
# Секрет backend-клиента
KEYCLOAK_BACKEND_CLIENT_SECRET=
# Включить обмен токенов
KEYCLOAK_TOKEN_EXCHANGE_ENABLED=false
# Администратор Keycloak (для контейнера start-dev)
KEYCLOAK_ADMIN_USER=admin
# Пароль администратора Keycloak
KEYCLOAK_ADMIN_PASSWORD=admin

# === MinIO ===
# Endpoint MinIO вида host:port
MINIO_ENDPOINT=
# Access key MinIO
MINIO_ACCESS_KEY=
# Secret key MinIO
MINIO_SECRET_KEY=
# Использовать HTTPS для MinIO
MINIO_USE_SSL=false
# Регион MinIO
MINIO_REGION=
# Бакет для аватаров
MINIO_AVATAR_BUCKET=avatars
# Бакет для отчётов
MINIO_REPORT_BUCKET=reports

# === Rate Limits ===
# Лимит запросов на пользователя
RATE_LIMIT_USER_REQUESTS=0
# Окно лимита пользователя
RATE_LIMIT_USER_WINDOW=1m
# Лимит запросов на IP
RATE_LIMIT_IP_REQUESTS=0
# Окно лимита IP
RATE_LIMIT_IP_WINDOW=1m

# === Tracing ===
# Включить OpenTelemetry
TRACING_ENABLED=false
# Провайдер трассировки
TRACING_PROVIDER=opentracing
# Endpoint коллектора
TRACING_ENDPOINT=
# Имя сервиса в трассировке
TRACING_SERVICE_NAME=emplacc-api
# Доля выборки (0-1)
TRACING_SAMPLE_RATE=1

# === MCP (gRPC) ===
# Адрес gRPC сервиса MCP
MCP_GRPC_ADDRESS=
# Таймаут запросов к MCP
MCP_GRPC_TIMEOUT=5s
# Использовать TLS для подключения к MCP
MCP_GRPC_USE_TLS=false

# === Pagination ===
# Лимит по умолчанию для списков
PAGINATION_DEFAULT_LIMIT=10
# Максимальный размер страницы
PAGINATION_MAX_LIMIT=100
