# === Application ===
APP_NAME=emplacc-api
APP_VERSION=1.0.0
APP_ENV=development
APP_TIMEZONE=Europe/Moscow

# === Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_ALLOWED_ORIGINS=*
SERVER_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
SERVER_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
SERVER_ALLOW_CREDENTIALS=true

# === Database ===
DB_NAME=postgres
DB_USER=postgres
DB_PASS=admin
DB_PORT=5432
DB_HOST=postgres_new
DB_SSLMODE=disable
DB_TIMEZONE=Europe/Moscow
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_AUTO_MIGRATE=true

# === Logger ===
LOG_LEVEL=info
LOG_FORMAT=text
LOG_FILE=logs/app.log
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

# === Keycloak ===
KEYCLOAK_URL=https://example-keycloak.local
KEYCLOAK_REALM=master-users
KEYCLOAK_CLIENT_ID=emplacc-api
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_BACKEND_CLIENT_ID=
KEYCLOAK_BACKEND_CLIENT_SECRET=
KEYCLOAK_TOKEN_EXCHANGE_ENABLED=false

# === MinIO ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=access-key
MINIO_SECRET_KEY=secret-key
MINIO_USE_SSL=false
MINIO_REGION=
MINIO_AVATAR_BUCKET=avatars
MINIO_REPORT_BUCKET=reports

# === Rate Limits ===
RATE_LIMIT_USER_REQUESTS=0
RATE_LIMIT_USER_WINDOW=1m
RATE_LIMIT_IP_REQUESTS=0
RATE_LIMIT_IP_WINDOW=1m

# === Tracing ===
TRACING_ENABLED=false
TRACING_PROVIDER=otlphttp
TRACING_ENDPOINT=http://otel-collector:4318
TRACING_SERVICE_NAME=emplacc-api
TRACING_SAMPLE_RATE=1

# === Pagination ===
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100
