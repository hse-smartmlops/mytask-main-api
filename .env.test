# Минимальная конфигурация для локального docker-compose

APP_NAME=emplacc-api
APP_VERSION=1.0.0
APP_ENV=test
APP_TIMEZONE=UTC

SERVER_HOST=0.0.0.0
SERVER_PORT=8081
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_ALLOWED_ORIGINS=*
SERVER_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
SERVER_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
SERVER_ALLOW_CREDENTIALS=true

DB_NAME=emplacc
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432
DB_HOST=postgres
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_AUTO_MIGRATE=true

LOG_LEVEL=info
LOG_FORMAT=text
LOG_FILE=
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

SWAGGER_ENABLED=true
SWAGGER_TITLE=Emplacc API
SWAGGER_DESCRIPTION=Test environment
SWAGGER_VERSION=1.0
SWAGGER_HOST=
SWAGGER_BASE_PATH=/
SWAGGER_SCHEMES=

KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_BACKEND_CLIENT_ID=
KEYCLOAK_BACKEND_CLIENT_SECRET=
KEYCLOAK_TOKEN_EXCHANGE_ENABLED=false

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=
MINIO_AVATAR_BUCKET=avatars
MINIO_REPORT_BUCKET=reports

RATE_LIMIT_USER_REQUESTS=0
RATE_LIMIT_USER_WINDOW=1m
RATE_LIMIT_IP_REQUESTS=0
RATE_LIMIT_IP_WINDOW=1m

TRACING_ENABLED=false
TRACING_PROVIDER=opentracing
TRACING_ENDPOINT=
TRACING_SERVICE_NAME=emplacc-api
TRACING_SAMPLE_RATE=1

PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100
